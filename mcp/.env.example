# ============================================================================
# MCP-сервер OpenConnect: пример конфигурации.
# Скопируйте в .env (файл в git не попадает) и заполните обязательные значения.
#
# Значения ниже — «безопасные» (релизные): разрушительные операции выключены,
# сырые логи не пишутся, debug-блок в ответах недоступен.
# Для отладки на стенде: SSVC_ALLOW_DESTRUCTIVE=1, SSVC_RAW_LOG=all, SSVC_ALLOW_DEBUG=1.
# ============================================================================

# --- Контроллер OpenConnect (обязательно) -----------------------------------
# Полный базовый URL, без завершающего слэша. Прошивка слушает только HTTP, порт 80.
SSVC_DEVICE_URL=http://192.168.1.42
# Учётная запись контроллера. Нужна именно admin: /rest/telemetry и /rest/sensor
# отдают данные только администратору, иначе половина инструментов вернёт 403.
SSVC_USER=admin
SSVC_PASSWORD=
# Таймаут одного HTTP-запроса к контроллеру, мс: 100..600000 (по умолчанию 10000).
# Скачивание журнала и файла идут со своим бюджетом (45 и 60 с) — эта переменная их не режет.
SSVC_DEVICE_TIMEOUT_MS=10000
# Частота фонового опроса состояния, Гц: 0.1..10 (по умолчанию 1).
# Выше 2 Гц на ESP32 смысла нет: прошивка обновляет снимок примерно раз в две секунды.
SSVC_POLL_HZ=1

# --- Доступ MCP-клиентов (обязательно) --------------------------------------
# Bearer-токен. Сгенерировать: openssl rand -hex 32
# Сервер не стартует без этого значения.
SSVC_MCP_TOKEN=

# Адрес прослушивания: 127.0.0.1 — только локально, 0.0.0.0 — вся сеть.
SSVC_MCP_BIND=127.0.0.1
SSVC_MCP_PORT=8080

# Список допустимых значений заголовка Host (через запятую), защита от DNS-rebinding.
# Пусто = localhost/127.0.0.1/[::1] + адрес из SSVC_MCP_BIND.
# При SSVC_MCP_BIND=0.0.0.0 укажите явно, например: 192.168.1.10,openconnect.local
SSVC_MCP_ALLOWED_HOSTS=

# Кто может подключаться (CIDR через запятую). Значение private = RFC1918
# (10/8, 172.16/12, 192.168/16) плюс петлевые адреса.
SSVC_MCP_ALLOWED_CIDRS=private

# Пределы сессий: 32 сессии, закрытие простаивающей через 30 минут.
SSVC_MCP_MAX_SESSIONS=32
SSVC_MCP_IDLE_MS=1800000

# Встроенный TLS (оба файла сразу). Пусто = работа за TLS-прокси (Caddy/Traefik).
SSVC_MCP_TLS_CERT=
SSVC_MCP_TLS_KEY=

# --- Политика и наблюдаемость ----------------------------------------------
# Разрушительные операции (риск 3/4): 0 — выключены (disabled_by_policy).
SSVC_ALLOW_DESTRUCTIVE=0
# Разрешить debug:true в вызовах (блок raw в ответе).
SSVC_ALLOW_DEBUG=0

# Сырые обмены с устройством: off | errors | all
SSVC_RAW_LOG=off
SSVC_RAW_LOG_DIR=./logs/raw
SSVC_RAW_LOG_MAX_MB=50

# Журнал аудита опасных операций (JSONL).
SSVC_AUDIT_PATH=./logs/audit.jsonl

# Уровень логов: debug | info | warn | error | silent
SSVC_LOG_LEVEL=info
