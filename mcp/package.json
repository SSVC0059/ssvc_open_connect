{
  "name": "ssvc-openconnect-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP-сервер для контроллера OpenConnect (SSVC): HTTP-транспорт, клиент устройства, политика риска",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ssvc-openconnect-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \".test-dist/test/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  }
}
